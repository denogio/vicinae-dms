{
  "name": "vicinae-dms",
  "title": "DMS Control",
  "description": "Control DankMaterialShell via IPC from Vicinae",
  "categories": ["productivity", "developer-tools"],
  "license": "MIT",
  "author": "dehoej",
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "dms",
      "title": "DMS Control",
      "subtitle": "Control DankMaterialShell via IPC",
      "description": "Browse and execute DMS IPC commands",
      "mode": "view",
      "icon": "icons/dms-control.png"
    },
    {
      "name": "dms-wallpaper",
      "title": "DMS Wallpaper",
      "subtitle": "Manage wallpapers",
      "description": "Quick access to wallpaper controls",
      "mode": "view",
      "icon": "icons/dms-wallpaper.png"
    },
    {
      "name": "dms-theme",
      "title": "DMS Theme",
      "subtitle": "Toggle theme mode",
      "description": "Switch between light and dark themes",
      "mode": "view",
      "icon": "icons/dms-theme.png"
    },
    {
      "name": "dms-theme-dark",
      "title": "DMS Theme: Dark",
      "subtitle": "Activate dark theme",
      "description": "Switch to dark theme immediately",
      "mode": "no-view",
      "icon": "icons/dms-theme.png"
    },
    {
      "name": "dms-theme-light",
      "title": "DMS Theme: Light",
      "subtitle": "Activate light theme",
      "description": "Switch to light theme immediately",
      "mode": "no-view",
      "icon": "icons/dms-theme.png"
    },
    {
      "name": "dms-lock",
      "title": "DMS Lock",
      "subtitle": "Lock screen",
      "description": "Lock screen immediately",
      "mode": "no-view",
      "icon": "icons/dms-lock.png"
    },
    {
      "name": "dms-inhibit",
      "title": "DMS Inhibit",
      "subtitle": "Toggle idle inhibit",
      "description": "Prevent automatic sleep/lock",
      "mode": "no-view",
      "icon": "icons/dms-inhibit.png"
    },
    {
      "name": "dms-modals",
      "title": "DMS Modals",
      "subtitle": "Open and control shell modals",
      "description": "Access launcher, settings, clipboard, notifications, and more",
      "mode": "view",
      "icon": "icons/dms-modals.png"
    }
  ],
  "preferences": [
    {
      "name": "dms-binary-path",
      "title": "DMS Binary Path",
      "description": "Path to dms command (default: dms)",
      "required": false,
      "type": "textfield",
      "default": "dms"
    }
  ],
  "dependencies": {
    "@vicinae/api": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  }
}
