{
  "name": "vicinae-dms",
  "title": "DMS Control",
  "description": "Control DankMaterialShell via IPC from Vicinae",
  "categories": ["productivity", "developer-tools"],
  "license": "MIT",
  "author": "dehoej",
  "icon": "extension_icon.webp",
  "commands": [
    {
      "name": "dms",
      "title": "DMS Control",
      "subtitle": "Control DankMaterialShell via IPC",
      "description": "Browse and execute DMS IPC commands",
      "mode": "view",
      "icon": "Icon.List"
    },
    {
      "name": "dms-wallpaper",
      "title": "DMS Wallpaper",
      "subtitle": "Manage wallpapers",
      "description": "Quick access to wallpaper controls",
      "mode": "view",
      "icon": "Icon.Image"
    },
    {
      "name": "dms-theme",
      "title": "DMS Theme",
      "subtitle": "Toggle theme mode",
      "description": "Switch between light and dark themes",
      "mode": "no-view",
      "icon": "Icon.Sun"
    },
    {
      "name": "dms-lock",
      "title": "DMS Lock",
      "subtitle": "Lock screen",
      "description": "Lock screen immediately",
      "mode": "no-view",
      "icon": "Icon.Lock"
    },
    {
      "name": "dms-inhibit",
      "title": "DMS Inhibit",
      "subtitle": "Toggle idle inhibit",
      "description": "Prevent automatic sleep/lock",
      "mode": "no-view",
      "icon": "Icon.Moon"
    },
    {
      "name": "dms-modals",
      "title": "DMS Modals",
      "subtitle": "Open and control shell modals",
      "description": "Access launcher, settings, clipboard, notifications, and more",
      "mode": "view",
      "icon": "Icon.AppWindow"
    }
  ],
  "preferences": [
    {
      "name": "dms-binary-path",
      "title": "DMS Binary Path",
      "description": "Path to dms command (default: dms)",
      "required": false,
      "type": "textfield",
      "default": "dms"
    }
  ],
  "dependencies": {
    "@vicinae/api": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  }
}
